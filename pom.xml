<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>

	<groupId>com.edam</groupId>
	<artifactId>edam</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<!-- WAR packaging is mandatory: EDAM renders JSP views, which Spring Boot only
		 supports from an executable WAR (never from an executable JAR). -->
	<packaging>war</packaging>

	<name>EDAM</name>
	<description>Expense Delegation and Approval Management - platform foundation</description>

	<properties>
		<java.version>21</java.version>
		<springdoc.version>3.2.0</springdoc.version>
		<cloudinary.version>2.6.0</cloudinary.version>
		<thymeleaf.version>3.1.7.RELEASE</thymeleaf.version>
		<start-class>com.edam.EdamApplication</start-class>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

		<!-- Plugin versions not governed by spring-boot-starter-parent. -->
		<maven-war-plugin.version>3.4.0</maven-war-plugin.version>
		<maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
	</properties>

	<dependencies>
		<!-- ============================ Application ============================ -->

		<!-- Spring MVC + embedded Tomcat. Deliberately NOT spring-boot-starter-classic:
			 that starter pulls every optional feature module's auto-configuration (gRPC,
			 Cassandra, Kafka, ...) whose optional runtime libraries are absent, which
			 aborts bean creation with NoClassDefFoundError. EDAM declares only the
			 capabilities it actually uses. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
			<exclusions>
				<!--
				  The embedded container is declared as 'provided' below so that it is
				  packaged into WEB-INF/lib-provided. That keeps the WAR deployable to an
				  external servlet container while 'java -jar edam.war' still works.
				-->
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- Jackson is a separate starter in Boot 4 (JSON message conversion and the
			 JsonMapper bean used by the error envelope writers). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jackson</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Method-level authorization for institution-scoped permissions
			 (RequirePermissionAspect). Boot 4 names this starter '-aspectj'. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aspectj</artifactId>
		</dependency>

		<!-- OpenAPI 3 + Swagger UI. Version is pinned deliberately: 3.2.0 is built
			 against Spring Boot 4.1.2 / Framework 7, the same baseline as EDAM. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- Mail transport used by the institution-configurable email provider. It is an
			 adapter detail: business services depend on EdamMailSender, never on JavaMail. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- Server-side template rendering for institution e-mail templates. Templates are
			 rendered in a sandboxed context with no Spring beans and no arbitrary expressions
			 (see EmailTemplateRenderer). -->
		<dependency>
			<groupId>org.thymeleaf</groupId>
			<artifactId>thymeleaf</artifactId>
			<version>${thymeleaf.version}</version>
		</dependency>
		<!-- No thymeleaf-extras-java8time: Thymeleaf 3.1 ships the #temporals object natively,
			 and the extras artifact for that generation is not published to Maven Central. -->

		<!-- HTML sanitisation for e-mail templates and any rendered rich text. Prevents an
			 administrator-supplied template from injecting scripts (BRD MAIL-03 / §41). -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.24.1</version>
		</dependency>

		<!-- Media storage adapter. Cloudinary is ONE provider behind StorageProvider; the
			 dependency is confined to com.edam.storage.cloudinary. -->
		<dependency>
			<groupId>com.cloudinary</groupId>
			<artifactId>cloudinary-http5</artifactId>
			<version>${cloudinary.version}</version>
		</dependency>

		<!-- XLSX export for registers and reports (BRD FM-12, §33). -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.5.1</version>
		</dependency>

		<!-- ================================ Test ================================ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>edam</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Embedded Tomcat lives in WEB-INF/lib-provided so the WAR stays
						 deployable to an external servlet container. -->
					<mainClass>com.edam.EdamApplication</mainClass>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>${maven-war-plugin.version}</version>
				<configuration>
					<failOnMissingWebXml>false</failOnMissingWebXml>
					<archive>
						<manifest>
							<mainClass>${start-class}</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer-plugin.version}</version>
				<executions>
					<execution>
						<id>enforce-build-environment</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[21,)</version>
									<message>EDAM requires JDK 21 or newer.</message>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
								<bannedDependencies>
									<excludes>
										<!--
										  Logging note: Spring Framework 7 removed the spring-jcl shim and
										  depends on commons-logging, which therefore MUST stay on the
										  classpath. It presents the SLF4J API and routes to Logback via
										  logback-classic, so SLF4J remains the single logging facade.
										  Do not ban commons-logging.
										-->
										<exclude>commons-logging:commons-logging-jcl:*:*:jar</exclude>
										<exclude>log4j:log4j:*:*:jar</exclude>
										<exclude>org.slf4j:slf4j-log4j12:*:*:jar</exclude>
									</excludes>
									<message>EDAM uses SLF4J + Logback; legacy log4j 1.x bridges are not permitted.</message>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Developer profile: sensible local defaults, no secrets committed. -->
		<profile>
			<id>local</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<properties>
				<spring.profiles.active>local</spring.profiles.active>
			</properties>
		</profile>
	</profiles>

</project>
