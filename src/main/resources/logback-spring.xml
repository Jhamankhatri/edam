<?xml version="1.0" encoding="UTF-8"?>
<!--
  EDAM logging configuration.

  * Correlation ID is present on every line, at every level.
  * A single console appender keeps container logs authoritative; side files are a
    deployment concern (volume mounts / log shippers), not an application concern.
  * Levels are configured via logging.level.* properties, never hard-coded here, so an
    operator can change verbosity without a rebuild.
  * Optional JSON output: Spring Boot replaces this appender's encoder when
    LOG_CONSOLE_LOG_STRUCTURED_FORMAT is set (see application-prod.yml and the Boot
    structured-logging documentation). The pattern below is the fallback.
  * Redaction is a code-level responsibility; see LOGGING_GUIDELINES.md.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN:-%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [%X{correlationId:-no-correlation-id}] %logger{36} - %msg%n}</pattern>
            <charset>${CONSOLE_LOG_CHARSET:-UTF-8}</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
