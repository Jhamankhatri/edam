<?xml version="1.0" encoding="UTF-8"?>
<!--
  EDAM logging configuration.

  * Correlation ID is present on every line, at every level.
  * A single console appender keeps container logs authoritative; side files are a
    deployment concern (volume mounts / log shippers), not an application concern.
  * Levels are configured via logging.level.* properties, never hard-coded here, so an
    operator can change verbosity without a rebuild.
  * Redaction is a code-level responsibility; see LOGGING_GUIDELINES.md.

  Why structured output is configured here rather than by property:
  Spring Boot only substitutes a structured encoder into the appenders it builds itself.
  This file declares its own console appender, so logging.structured.format.console is
  inert. The `prod` profile therefore selects StructuredLogEncoder explicitly through
  springProfile. ECS field names are produced by Boot's ElasticCommonSchemaStructuredLogFormatter,
  which needs a Jackson mapper; spring-boot-starter-jackson supplies one.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Human-readable line output: local, test and any deployment without the prod profile. -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>${CONSOLE_LOG_PATTERN:-%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [%X{correlationId:-no-correlation-id}] %logger{36} - %msg%n}</pattern>
                <charset>${CONSOLE_LOG_CHARSET:-UTF-8}</charset>
            </encoder>
        </appender>
    </springProfile>

    <!-- Production: one JSON object per line, ECS field names, MDC included (correlationId). -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>ecs</format>
                <charset>${CONSOLE_LOG_CHARSET:-UTF-8}</charset>
            </encoder>
        </appender>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
